{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MySQL Test Case",
  "scopeName": "source.mysql-test",
  "patterns": [
    { "include": "#comments" },
    { "include": "#mtr-directives" },
    { "include": "#mtr-control-flow" },
    { "include": "#mtr-variables" },
    { "include": "#mtr-functions" },
    { "include": "#strings" },
    { "include": "#sql" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mysql-test",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "mtr-directives": {
      "patterns": [
        {
          "comment": "SQL-containing -- directives (must come before generic)",
          "begin": "^(\\s*)(--)\\s*(eval|query|send|send_eval)\\b",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" },
            { "include": "#sql" }
          ]
        },
        {
          "comment": "perl block with -- prefix, default EOF end marker",
          "begin": "^(\\s*)(--)\\s*perl\\s*$",
          "end": "^\\s*EOF\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" }
          },
          "endCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.perl",
          "patterns": [
            { "include": "#perl-content" }
          ]
        },
        {
          "comment": "perl block with -- prefix, custom end marker",
          "begin": "^(\\s*)(--)\\s*perl\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^\\s*[A-Za-z_][A-Za-z0-9_]*\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "string.unquoted.mtr.mysql-test" }
          },
          "endCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.perl",
          "patterns": [
            { "include": "#perl-content" }
          ]
        },
        {
          "comment": "let directive (supports string values)",
          "begin": "^(\\s*)(--)\\s*(let)\\b",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" },
            { "include": "#strings" }
          ]
        },
        {
          "comment": "die directive (raw string, variables are NOT expanded)",
          "begin": "^(\\s*)(--)\\s*(die)\\b",
          "end": "$",
          "contentName": "string.unquoted.mtr.mysql-test",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#strings" }
          ]
        },
        {
          "comment": "exec directives (shell content)",
          "begin": "^(\\s*)(--)\\s*(exec[_a-z]*)\\b",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.shell",
          "patterns": [
            { "include": "#mtr-variables" }
          ]
        },
        {
          "comment": "echo directive (entire content is a string)",
          "begin": "^(\\s*)(--)\\s*(echo)\\b",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "string.unquoted.mtr.mysql-test",
          "patterns": [
            { "include": "#mtr-variables" }
          ]
        },
        {
          "comment": "file path directives (path content as link)",
          "begin": "^(\\s*)(--)\\s*(source|write_file|append_file|copy_file|copy_files_wildcard|move_file|remove_file|remove_files_wildcard|cat_file|list_files|list_files_append_file|list_files_write_file|mkdir|rmdir|chmod|file_exists|diff_files)\\b",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "name": "markup.underline.link", "match": "[A-Za-z0-9_./\\-]+" }
          ]
        },
        {
          "comment": "Generic -- directives (non-SQL, no strings)",
          "begin": "^(\\s*)(--)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.mysql-test" },
            "2": { "name": "punctuation.definition.directive.mysql-test" },
            "3": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" }
          ]
        },
        {
          "comment": "SQL-containing bare commands (must come before generic)",
          "begin": "^\\s*(query|send|send_eval|eval|query_horizontal|query_vertical)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" },
            { "include": "#sql" }
          ]
        },
        {
          "comment": "let command without -- prefix (supports string values)",
          "begin": "^\\s*(let)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" },
            { "include": "#strings" }
          ]
        },
        {
          "comment": "die command without -- prefix (raw string, variables are NOT expanded)",
          "begin": "^\\s*(die)\\b",
          "end": "$",
          "contentName": "string.unquoted.mtr.mysql-test",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#strings" }
          ]
        },
        {
          "comment": "exec commands without -- prefix (shell content)",
          "begin": "^\\s*(exec[_a-z]*)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.shell",
          "patterns": [
            { "include": "#mtr-variables" }
          ]
        },
        {
          "comment": "echo command without -- prefix (entire content is a string)",
          "begin": "^\\s*(echo)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "string.unquoted.mtr.mysql-test",
          "patterns": [
            { "include": "#mtr-variables" }
          ]
        },
        {
          "comment": "file path commands without -- prefix (path content as link)",
          "begin": "^\\s*(source|write_file|append_file|copy_file|copy_files_wildcard|move_file|remove_file|remove_files_wildcard|cat_file|list_files|list_files_append_file|list_files_write_file|mkdir|rmdir|chmod|file_exists|diff_files)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "name": "markup.underline.link", "match": "[A-Za-z0-9_./\\-]+" }
          ]
        },
        {
          "comment": "perl block without -- prefix, default EOF end marker",
          "begin": "^\\s*perl\\s*;\\s*$",
          "end": "^\\s*EOF\\s*$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "endCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.perl",
          "patterns": [
            { "include": "#perl-content" }
          ]
        },
        {
          "comment": "perl block without -- prefix, custom end marker",
          "begin": "^\\s*perl\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*;\\s*$",
          "end": "^\\s*[A-Za-z_][A-Za-z0-9_]*\\s*$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" },
            "1": { "name": "string.unquoted.mtr.mysql-test" }
          },
          "endCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "contentName": "source.perl",
          "patterns": [
            { "include": "#perl-content" }
          ]
        },
        {
          "comment": "MTR commands without -- prefix (non-SQL, no strings)",
          "begin": "^\\s*(append_file|assert|cat_file|change_user|character_set|chmod|connect|connection|copy_file|copy_files_wildcard|dec|delimiter|diff_files|dirty_close|disable_abort_on_error|disable_async_client|disable_connect_log|disable_info|disable_metadata|disable_ps_protocol|disable_query_log|disable_result_log|disable_rpl_parse|disable_session_track_info|disable_testcase|disable_warnings|disconnect|enable_abort_on_error|enable_async_client|enable_connect_log|enable_info|enable_metadata|enable_ps_protocol|enable_query_log|enable_result_log|enable_rpl_parse|enable_session_track_info|enable_warnings|end|end_timer|error|exit|expr|file_exists|force|horizontal_results|inc|list_files|list_files_append_file|list_files_write_file|lowercase_result|mkdir|move_file|output|partially_sorted_result|ping|query_get_value|reap|remove_file|remove_files_wildcard|replace_column|replace_numeric_round|replace_regex|replace_result|reset_connection|result_format|rmdir|save_master_pos|send_quit|send_shutdown|shutdown_server|skip|sleep|sorted_result|source|start_timer|sync_slave_with_master|sync_with_master|vertical_results|wait_for_slave_to_stop|write_file)\\b",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "entity.name.function.directive.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#mtr-functions" }
          ]
        }
      ]
    },
    "mtr-control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.mysql-test",
          "match": "^\\s*(if|then|else|end\\s+if|while)\\b"
        },
        {
          "name": "punctuation.section.block.mysql-test",
          "match": "[{}]"
        }
      ]
    },
    "perl-content": {
      "patterns": [
        { "include": "#strings" },
        {
          "name": "comment.line.number-sign.perl",
          "match": "#.*$"
        },
        {
          "name": "keyword.control.perl",
          "match": "(?i)\\b(if|elsif|else|unless|while|until|for|foreach|given|when|default|continue|next|last|redo|return|die|exit|warn|eval|sub|package|require|use|no|BEGIN|END|do|say|my|our|local|state|undef|defined|ref|bless|eq|ne|lt|gt|le|ge|not|and|or|xor|cmp|print)\\b"
        },
        {
          "name": "support.function.perl",
          "match": "(?i)\\b(open|close|chomp|chop|chdir|chmod|chown|crypt|exec|fork|getpwnam|glob|gmtime|localtime|mkdir|unlink|rename|rmdir|read|readline|seek|tell|truncate|write|print|printf|sprintf|sprintf|sleep|system|time|times|umask|wait|waitpid|alarm|kill|pipe|select|socket|connect|bind|listen|accept|send|recv|shutdown|split|join|reverse|sort|map|grep|substr|index|rindex|length|lc|uc|lcfirst|ucfirst|chr|ord|hex|oct|int|abs|cos|sin|exp|log|sqrt|rand|srand|push|pop|shift|unshift|splice|keys|values|each|exists|delete|tie|untie|binmode|fileno|flock|stat|lstat|readlink|symlink|truncate)\\b"
        },
        {
          "name": "variable.other.readwrite.perl",
          "match": "[\\$@%]([A-Za-z_][A-Za-z0-9_]*)\\b"
        },
        {
          "name": "variable.other.readwrite.perl",
          "match": "[\\$@%]\\{[^}]*\\}"
        },
        {
          "name": "keyword.operator.comparison.perl",
          "match": "(?<=\\s)(==|!=|<|>|<=|>=|<=>|eq|ne|lt|gt|le|ge|cmp)(?=\\s)"
        },
        {
          "name": "keyword.operator.assignment.perl",
          "match": "(?<![=!<>])(=)(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.perl",
          "match": "(?<=\\s)[+\\-*/%](?=\\s)"
        },
        {
          "name": "keyword.operator.string.perl",
          "match": "\\."
        },
        {
          "name": "constant.numeric.perl",
          "match": "\\b(0x[0-9a-fA-F]+|\\d+(?:\\.\\d*)?)\\b"
        },
        {
          "name": "constant.language.perl",
          "match": "(?i)\\b(true|false|null|__FILE__|__LINE__|__PACKAGE__|__SUB__|STDIN|STDOUT|STDERR|ARGV)\\b"
        }
      ]
    },
    "mtr-variables": {
      "patterns": [
        {
          "name": "variable.other.mtr.mysql-test",
          "match": "\\x24[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "mtr-functions": {
      "patterns": [
        {
          "contentName": "meta.function-call.arguments.mtr.mysql-test",
          "begin": "\\b(query_get_value|convert_error)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "entity.name.function.mtr.mysql-test" },
            "2": { "name": "punctuation.definition.arguments.begin.mtr.mysql-test" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.arguments.end.mtr.mysql-test" }
          },
          "patterns": [
            { "include": "#mtr-variables" },
            { "include": "#sql" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.mtr.mysql-test",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.mtr.mysql-test",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.mtr.mysql-test",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mtr.mysql-test",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.mtr.mysql-test",
          "begin": "`",
          "end": "`",
          "contentName": "meta.embedded.sql.mtr.mysql-test",
          "patterns": [
            {
              "name": "constant.character.escape.mtr.mysql-test",
              "match": "``"
            },
            { "include": "#sql" }
          ]
        }
      ]
    },
    "sql": {
      "patterns": [
        { "include": "#strings" },
        {
          "name": "keyword.other.sql.ddl.mysql-test",
          "match": "(?i)\\b(CREATE|ALTER|DROP|RENAME|TRUNCATE|TABLE|DATABASE|SCHEMA|INDEX|VIEW|TRIGGER|PROCEDURE|FUNCTION|EVENT|TEMPORARY|IF\\s+NOT\\s+EXISTS|IF\\s+EXISTS)\\b"
        },
        {
          "name": "keyword.other.sql.dml.mysql-test",
          "match": "(?i)\\b(SELECT|INSERT|INTO|VALUES|UPDATE|SET|DELETE|REPLACE|MERGE|CALL|EXECUTE|FROM|WHERE|JOIN|INNER|OUTER|LEFT|RIGHT|FULL|CROSS|ON|USING|GROUP\\s+BY|HAVING|ORDER\\s+BY|LIMIT|OFFSET|UNION|ALL|DISTINCT|INTERSECT|EXCEPT|AS|AND|OR|NOT|IN|BETWEEN|LIKE|IS|NULL|EXISTS|CASE|WHEN|THEN|ELSE|END|WITH|RECURSIVE)\\b"
        },
        {
          "name": "keyword.other.sql.mysql-test",
          "match": "(?i)\\b(SHOW|DESCRIBE|EXPLAIN|USE|START|BEGIN|COMMIT|ROLLBACK|SAVEPOINT|LOCK|UNLOCK|GRANT|REVOKE|PREPARE|DEALLOCATE|DECLARE|HANDLER|OPEN|CLOSE|FETCH|RETURN|LEAVE|ITERATE|LOOP|REPEAT|WHILE|CURSOR|FOR|CONTINUE\\s+HANDLER|EXIT\\s+HANDLER|SIGNAL|RESIGNAL|GET\\s+DIAGNOSTICS)\\b"
        },
        {
          "name": "keyword.other.sql.admin.mysql-test",
          "match": "(?i)\\b(ANALYZE|CHECK|OPTIMIZE|REPAIR|BACKUP|RESTORE|INSTALL|UNINSTALL|SHUTDOWN|RESTART|KILL|LOAD|DATA|INFILE|OUTFILE|DUMPFILE|FLUSH|RESET|PURGE|MASTER|SLAVE|REPLICA|SOURCE|REPLICATION|CHANGE|STOP|START|CONFIG|XA)\\b"
        },
        {
          "name": "keyword.other.sql.types.mysql-test",
          "match": "(?i)\\b(INT|INTEGER|TINYINT|SMALLINT|MEDIUMINT|BIGINT|FLOAT|DOUBLE|DECIMAL|NUMERIC|CHAR|VARCHAR|BINARY|VARBINARY|TINYBLOB|BLOB|MEDIUMBLOB|LONGBLOB|TINYTEXT|TEXT|MEDIUMTEXT|LONGTEXT|DATE|TIME|DATETIME|TIMESTAMP|YEAR|ENUM|SET|BOOL|BOOLEAN|SERIAL|FIXED|GEOMETRY|POINT|LINESTRING|POLYGON|MULTIPOINT|MULTILINESTRING|MULTIPOLYGON|GEOMETRYCOLLECTION|JSON|VECTOR)\\b"
        },
        {
          "name": "keyword.other.sql.constraints.mysql-test",
          "match": "(?i)\\b(PRIMARY|KEY|UNIQUE|FOREIGN|REFERENCES|CONSTRAINT|CHECK|DEFAULT|AUTO_INCREMENT|UNSIGNED|ZEROFILL|ON\\s+DELETE|ON\\s+UPDATE|CASCADE|RESTRICT|SET\\s+NULL|NO\\s+ACTION)\\b"
        },
        {
          "name": "keyword.other.sql.functions.mysql-test",
          "match": "(?i)\\b(AVG|COUNT|MAX|MIN|SUM|GROUP_CONCAT|CONCAT|LENGTH|SUBSTRING|TRIM|UPPER|LOWER|REPLACE|REVERSE|LEFT|RIGHT|LPAD|RPAD|INSERT|LOCATE|INSTR|FIELD|FIND_IN_SET|FORMAT|CONV|HEX|UNHEX|CAST|CONVERT|COALESCE|IFNULL|NULLIF|IF|CASE|GREATEST|LEAST|ROW_COUNT|FOUND_ROWS|LAST_INSERT_ID|CONNECTION_ID|VERSION|DATABASE|USER|CURRENT_USER|CURRENT_DATE|CURRENT_TIME|CURRENT_TIMESTAMP|NOW|CURDATE|CURTIME|DATE|DATE_ADD|DATE_SUB|DATEDIFF|DATE_FORMAT|EXTRACT|YEAR|MONTH|DAY|HOUR|MINUTE|SECOND|MICROSECOND|QUARTER|WEEK|YEARWEEK|TIMESTAMPDIFF|TIMESTAMPADD|UNIX_TIMESTAMP|FROM_UNIXTIME|SEC_TO_TIME|TIME_TO_SEC|STR_TO_DATE|MD5|SHA|SHA1|SHA2|PASSWORD|ENCRYPT|DECODE|ENCODE|AES_ENCRYPT|AES_DECRYPT|COMPRESS|UNCOMPRESS|RANDOM_BYTES|UUID|UUID_SHORT|SLEEP|BENCHMARK|GET_LOCK|RELEASE_LOCK|IS_FREE_LOCK|IS_USED_LOCK|INET_ATON|INET_NTOA|INET6_ATON|INET6_NTOA|JSON_EXTRACT|JSON_CONTAINS|JSON_ARRAY|JSON_OBJECT|JSON_TYPE|JSON_VALID|JSON_LENGTH|JSON_DEPTH|JSON_KEYS|JSON_INSERT|JSON_REPLACE|JSON_REMOVE|JSON_SET|JSON_UNQUOTE|JSON_SEARCH|JSON_ARRAY_APPEND|JSON_ARRAY_INSERT|JSON_MERGE_PATCH|JSON_MERGE_PRESERVE|REGEXP|RLIKE|NOT\\s+REGEXP|SOUNDS\\s+LIKE|MATCH|AGAINST|FULLTEXT|SPATIAL|ELT|FIELD)\\b"
        },
        {
          "name": "keyword.other.sql.variables.mysql-test",
          "match": "(?i)\\b(GLOBAL|SESSION|LOCAL|@@|@)\\b"
        },
        {
          "name": "constant.language.sql.mysql-test",
          "match": "(?i)\\b(TRUE|FALSE|UNKNOWN|NULL)\\b"
        },
        {
          "name": "support.function.mysql-test",
          "match": "(?i)\\b(enable_async_client|disable_async_client)\\b"
        },
        {
          "name": "constant.numeric.sql.mysql-test",
          "match": "\\b(\\d+\\.?\\d*([eE][+-]?\\d+)?)\\b"
        },
        {
          "name": "punctuation.terminator.statement.sql.mysql-test",
          "match": ";"
        }
      ]
    }
  }
}
